# OpenAI
OPENAI_API_KEY=sk-...
# Optional: override the default model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Pushover (used to notify you when a visitor leaves contact info or asks
# something the twin can't answer). Optional — if unset, notifications are
# skipped and logged to the console instead.
PUSHOVER_USER=
PUSHOVER_TOKEN=
