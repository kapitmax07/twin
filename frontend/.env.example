# OpenAI
OPENAI_API_KEY=sk-...
# Optional: override the default model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Telegram (used to notify you when a visitor leaves contact info or asks
# something the twin can't answer). Optional — if unset, notifications are
# skipped and logged to the console instead.
# TELEGRAM_BOT_TOKEN: from @BotFather after creating a bot.
# TELEGRAM_CHAT_ID: the chat/user id the bot should message (e.g. from
# @userinfobot, or the "chat":{"id":...} field in a getUpdates response).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
